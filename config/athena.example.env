# Copy this file to .env in the project root.
# Values already set in the environment stay as they are.
# Leave ATHENA_SYSTEM_PROMPT unset to keep the built-in source-citation rules.

ATHENA_MODEL=qwen2.5:1.5b
ATHENA_OLLAMA_URL=http://127.0.0.1:11434
ATHENA_NUM_CTX=1536
ATHENA_HISTORY_MESSAGES=8
ATHENA_DOCS_TIMEOUT=300

# Uncomment to change the default session.
# ATHENA_DOCMODE=on
# ATHENA_WEBMODE=on
# ATHENA_SPEAK=on

# Vision stays off until you choose a model. moondream is a small option.
# ATHENA_VISION_MODEL=moondream

# Read-only Jenkins status. Keep real tokens out of Git.
# ATHENA_JENKINS_URL=http://127.0.0.1:8080
# ATHENA_JENKINS_USER=
# ATHENA_JENKINS_TOKEN=
